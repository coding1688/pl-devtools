{
    "name": "coding1688/pl-devtools",
    "description": "Opt-in Laravel developer tools: request profiler, SQL timeline, server and security diagnostics.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "devtools",
        "debug",
        "sql",
        "profiler",
        "diagnostics"
    ],
    "authors": [
        {
            "name": "coding1688"
        }
    ],
    "homepage": "https://github.com/coding1688/pl-devtools",
    "support": {
        "issues": "https://github.com/coding1688/pl-devtools/issues",
        "source": "https://github.com/coding1688/pl-devtools"
    },
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^10.5|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Coding1688\\DevTools\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Coding1688\\DevTools\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Coding1688\\DevTools\\DevToolsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
